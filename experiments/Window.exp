SW5A = --config=$(HERMES_HOME)/config/sleepwalk.ini --window_size=150000000 --sleep_frac=0.2
SW5B = --config=$(HERMES_HOME)/config/sleepwalk.ini --window_size=150000000 --sleep_frac=0.3
SW5C = --config=$(HERMES_HOME)/config/sleepwalk.ini --window_size=150000000 --sleep_frac=0.5
