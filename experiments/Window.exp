SW4B = --config=$(HERMES_HOME)/config/sleepwalk.ini --window_size=120000000 --sleep_frac=0.3
SW4C = --config=$(HERMES_HOME)/config/sleepwalk.ini --window_size=120000000 --sleep_frac=0.5
SW4D = --config=$(HERMES_HOME)/config/sleepwalk.ini --window_size=120000000 --sleep_frac=0.7

